# Copy this file to .env and fill in your own values. .env is gitignored -
# never commit real credentials.
#
# Optional: without these, sosmed_sentiment/cli/analyze runs on the local
# model alone (no LLM escalation for low-confidence comments) - a warning is
# logged, the run still completes.

# API key for your LLM router (OpenAI-compatible endpoint - OpenRouter or
# similar, not necessarily OpenAI/Anthropic directly).
LLM_API_KEY=

# Base URL of that router, up to and including /v1 - e.g.
# https://openrouter.ai/api/v1 or http://localhost:PORT/v1 for a local
# router. Do NOT include /chat/completions - the OpenAI SDK appends that
# itself, so including it here doubles the path and 404s.
LLM_BASE_URL=

# Model name as your router expects it, e.g. openai/gpt-4o-mini
LLM_MODEL=
